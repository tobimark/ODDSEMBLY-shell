# --- dependencies & build output ------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo

# --- local scratch, browser profiles, logs --------------------------------------
.tmp/
.tmp-*/
*.log

# --- capture / review artifacts -------------------------------------------------
# Screenshots, recordings, dial-motion frames and handoff archives are outputs,
# regenerated by the scripts in scripts/ (and shell/tools/). The scripts stay in
# the repo; their output does not. Review *write-ups* (.md) are kept: they are
# documentation, not artifacts.
review/**
!review/**/
!review/**/*.md
shots/
shell/tools/demo/out/
*.zip
*.bundle
